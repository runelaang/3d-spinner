{
  "name": "3d-spinner",
  "version": "0.9.28",
  "description": "Zero-dependency 3D spinners, loaders, and progress indicators for the browser - ready-made prefabs, GPU auto (WebGPU/WebGL) with Canvas 2D fallback.",
  "type": "module",
  "main": "./dist/cjs/index.cjs",
  "module": "./dist/index.js",
  "browser": "./dist/umd/spinner.global.js",
  "unpkg": "./dist/umd/spinner.global.min.js",
  "jsdelivr": "./dist/umd/spinner.global.min.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/cjs/index.d.cts",
        "default": "./dist/cjs/index.cjs"
      }
    },
    "./animations/spin": {
      "import": {
        "types": "./dist/animations/spin.d.ts",
        "default": "./dist/animations/spin.js"
      },
      "require": {
        "types": "./dist/cjs/animations/spin.d.cts",
        "default": "./dist/cjs/animations/spin.cjs"
      }
    },
    "./animations/object-motion": {
      "import": {
        "types": "./dist/animations/object-motion.d.ts",
        "default": "./dist/animations/object-motion.js"
      },
      "require": {
        "types": "./dist/cjs/animations/object-motion.d.cts",
        "default": "./dist/cjs/animations/object-motion.cjs"
      }
    },
    "./animations/particles": {
      "import": {
        "types": "./dist/animations/particles.d.ts",
        "default": "./dist/animations/particles.js"
      },
      "require": {
        "types": "./dist/cjs/animations/particles.d.cts",
        "default": "./dist/cjs/animations/particles.cjs"
      }
    },
    "./animations/charged-orb": {
      "import": {
        "types": "./dist/animations/charged-orb.d.ts",
        "default": "./dist/animations/charged-orb.js"
      },
      "require": {
        "types": "./dist/cjs/animations/charged-orb.d.cts",
        "default": "./dist/cjs/animations/charged-orb.cjs"
      }
    },
    "./animations/ghost-train": {
      "import": {
        "types": "./dist/animations/ghost-train.d.ts",
        "default": "./dist/animations/ghost-train.js"
      },
      "require": {
        "types": "./dist/cjs/animations/ghost-train.d.cts",
        "default": "./dist/cjs/animations/ghost-train.cjs"
      }
    },
    "./animations/grid-assembly": {
      "import": {
        "types": "./dist/animations/grid-assembly.d.ts",
        "default": "./dist/animations/grid-assembly.js"
      },
      "require": {
        "types": "./dist/cjs/animations/grid-assembly.d.cts",
        "default": "./dist/cjs/animations/grid-assembly.cjs"
      }
    },
    "./animations/rocket-launch": {
      "import": {
        "types": "./dist/animations/rocket-launch.d.ts",
        "default": "./dist/animations/rocket-launch.js"
      },
      "require": {
        "types": "./dist/cjs/animations/rocket-launch.d.cts",
        "default": "./dist/cjs/animations/rocket-launch.cjs"
      }
    },
    "./composite-animation": {
      "import": {
        "types": "./dist/composite-animation.d.ts",
        "default": "./dist/composite-animation.js"
      },
      "require": {
        "types": "./dist/cjs/composite-animation.d.cts",
        "default": "./dist/cjs/composite-animation.cjs"
      }
    },
    "./prefabs": {
      "import": {
        "types": "./dist/prefabs/prefabs.d.ts",
        "default": "./dist/prefabs/prefabs.js"
      },
      "require": {
        "types": "./dist/cjs/prefabs/prefabs.d.cts",
        "default": "./dist/cjs/prefabs/prefabs.cjs"
      }
    },
    "./motion": {
      "import": {
        "types": "./dist/motion/motion.d.ts",
        "default": "./dist/motion/motion.js"
      },
      "require": {
        "types": "./dist/cjs/motion/motion.d.cts",
        "default": "./dist/cjs/motion/motion.cjs"
      }
    },
    "./motion/transitions": {
      "import": {
        "types": "./dist/motion/transitions.d.ts",
        "default": "./dist/motion/transitions.js"
      },
      "require": {
        "types": "./dist/cjs/motion/transitions.d.cts",
        "default": "./dist/cjs/motion/transitions.cjs"
      }
    },
    "./engines/little-3d-engine": {
      "import": {
        "types": "./dist/engines/little-3d-engine/little-3d-engine.d.ts",
        "default": "./dist/engines/little-3d-engine/little-3d-engine.js"
      },
      "require": {
        "types": "./dist/cjs/engines/little-3d-engine/little-3d-engine.d.cts",
        "default": "./dist/cjs/engines/little-3d-engine/little-3d-engine.cjs"
      }
    },
    "./engines/little-3d-engine/renderers/webgl-textured": {
      "import": {
        "types": "./dist/engines/little-3d-engine/renderers/webgl-textured.d.ts",
        "default": "./dist/engines/little-3d-engine/renderers/webgl-textured.js"
      },
      "require": {
        "types": "./dist/cjs/engines/little-3d-engine/renderers/webgl-textured.d.cts",
        "default": "./dist/cjs/engines/little-3d-engine/renderers/webgl-textured.cjs"
      }
    },
    "./engines/little-3d-engine/renderers/canvas2d-textured": {
      "import": {
        "types": "./dist/engines/little-3d-engine/renderers/canvas2d-textured.d.ts",
        "default": "./dist/engines/little-3d-engine/renderers/canvas2d-textured.js"
      },
      "require": {
        "types": "./dist/cjs/engines/little-3d-engine/renderers/canvas2d-textured.d.cts",
        "default": "./dist/cjs/engines/little-3d-engine/renderers/canvas2d-textured.cjs"
      }
    },
    "./engines/little-3d-engine/renderers/webgpu-textured": {
      "import": {
        "types": "./dist/engines/little-3d-engine/renderers/webgpu-textured.d.ts",
        "default": "./dist/engines/little-3d-engine/renderers/webgpu-textured.js"
      },
      "require": {
        "types": "./dist/cjs/engines/little-3d-engine/renderers/webgpu-textured.d.cts",
        "default": "./dist/cjs/engines/little-3d-engine/renderers/webgpu-textured.cjs"
      }
    },
    "./engines/little-3d-engine/loaders/obj": {
      "import": {
        "types": "./dist/engines/little-3d-engine/loaders/obj.d.ts",
        "default": "./dist/engines/little-3d-engine/loaders/obj.js"
      },
      "require": {
        "types": "./dist/cjs/engines/little-3d-engine/loaders/obj.d.cts",
        "default": "./dist/cjs/engines/little-3d-engine/loaders/obj.cjs"
      }
    },
    "./engines/little-tween-engine": {
      "import": {
        "types": "./dist/engines/little-tween-engine/little-tween-engine.d.ts",
        "default": "./dist/engines/little-tween-engine/little-tween-engine.js"
      },
      "require": {
        "types": "./dist/cjs/engines/little-tween-engine/little-tween-engine.d.cts",
        "default": "./dist/cjs/engines/little-tween-engine/little-tween-engine.cjs"
      }
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "clean": "node -e \"fs.rmSync('dist', { recursive: true, force: true })\"",
    "build:esm": "tsc",
    "build:cjs": "node scripts/build-cjs.mjs",
    "build:browser": "node scripts/build-browser.mjs",
    "build": "npm run clean && npm run build:esm && npm run build:cjs && npm run build:browser",
    "dev": "npx serve .",
    "lint": "eslint src",
    "format": "prettier --write \"src/**/*.ts\" \"scripts/**/*.mjs\" \"tests/**/*.mjs\" \"*.mjs\"",
    "format:check": "prettier --check \"src/**/*.ts\" \"scripts/**/*.mjs\" \"tests/**/*.mjs\" \"*.mjs\"",
    "pretest": "npm run build",
    "test": "node --test tests/*.test.mjs",
    "pretest:browser": "npm run build",
    "test:browser": "node --test tests/browser/*.test.mjs",
    "prepublishOnly": "npm run build"
  },
  "keywords": [
    "3d-spinner",
    "spinner",
    "loader",
    "loading",
    "3d",
    "progress"
  ],
  "author": "RuneL",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/runelaang/3d-spinner.git"
  },
  "homepage": "https://runelaang.github.io/3d-spinner/",
  "bugs": {
    "url": "https://github.com/runelaang/3d-spinner/issues"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@webgpu/types": "^0.1.74",
    "esbuild": "^0.28.1",
    "eslint": "^10.11.0",
    "playwright": "^1.63.0",
    "prettier": "^3.9.9",
    "typescript": "^5.7.0",
    "typescript-eslint": "^8.70.1"
  }
}
